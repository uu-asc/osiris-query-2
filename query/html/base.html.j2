{#
Frame for every error display: header, file path, message.
Context: e (the error), kind, title (list of str), raised_at (str), message (str), css.
#}
<div class="oq2-error">
<style>{{ css }}</style>
<div class="header"><b>{{ kind }}</b>{% for part in title %} · {{ part }}{% endfor %}<span class="time">{{ raised_at }}</span></div>
{% if e.path %}
<div class="path"><code>{{ e.path }}</code></div>
{% endif %}
<div class="msg">{{ message | linkify }}</div>
{% block body %}{% endblock %}
</div>
